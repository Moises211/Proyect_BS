<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="160dp" android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@android:color/white" app:cardCornerRadius="16dp" app:strokeColor="#B5B5B5" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp">
        <FrameLayout android:id="@+id/promotion_image" android:layout_width="match_parent" android:layout_height="62dp" android:background="@drawable/bg_promo_image" android:clickable="true" android:focusable="true" android:contentDescription="Cargar imagen de promoción">
            <ImageView android:id="@+id/promotion_image_preview" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />
            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Label" android:textColor="@android:color/white" android:textSize="16sp" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:id="@+id/promotion_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Especial Mes del Padre" android:textColor="#252525" android:textSize="16sp" android:textStyle="bold" />
                    <ImageView android:id="@+id/promotion_notification" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="4dp" android:src="@drawable/ic_notifications" android:tint="#D5A916" />
                </LinearLayout>
                <TextView android:id="@+id/promotion_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tipo: Catálogo" android:textColor="#777777" android:textSize="14sp" />
                <TextView android:id="@+id/promotion_catalog" android:layout_width="wrap_content" android:layout_height="wrap_content" android:drawableStart="@drawable/ic_sell" android:drawableTint="#147A3E" android:drawablePadding="6dp" android:text="Combo Papá e Hijo" android:textColor="#147A3E" android:textSize="15sp" />
            </LinearLayout>
            <ImageView android:id="@+id/action_edit_promotion" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_edit" android:tint="#4C4C56" />
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/promotion_active_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" app:thumbTint="@color/service_switch_thumb" app:trackTint="@color/service_switch_track" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
