<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/general_login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E4E4E4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <LinearLayout
        android:id="@+id/general_login_header"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_general_header">
        <ImageView
            android:layout_width="126dp"
            android:layout_height="126dp"
            android:padding="28dp"
            android:background="@drawable/bg_general_card_light"
            android:src="@drawable/ic_general_battery"
            android:contentDescription="Good Cuts" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="GOOD CUTS"
            android:textColor="@android:color/white"
            android:textSize="26sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Barber&#237;a m&#243;vil"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/general_login_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:paddingTop="42dp"
            android:paddingBottom="32dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bienvenido de nuevo"
                android:textColor="#252525"
                android:textSize="26sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ingresa tu correo electrónico y contrase&#241;a\npara continuar."
                android:textColor="#777777"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Correo electrónico"
                android:textColor="#252525"
                android:textSize="12sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/general_login_username"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_general_field_light"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="12dp"
                android:hint="ana.lopez@ejemplo.com"
                android:inputType="textEmailAddress"
                android:textColor="#333333"
                android:textColorHint="#888888" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Contrase&#241;a"
                android:textColor="#252525"
                android:textSize="12sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/general_login_password"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_general_field_light"
                android:drawableStart="@drawable/ic_general_lock"
                android:drawablePadding="12dp"
                android:drawableEnd="@drawable/ic_visibility"
                android:hint="&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;"
                android:inputType="textPassword"
                android:textColor="#333333"
                android:textColorHint="#888888" />
            <TextView
                android:id="@+id/general_login_forgot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="&#191;Olvidaste tu contrase&#241;a?"
                android:textColor="#287F8D"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/general_login_submit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_general_button"
                android:gravity="center"
                android:text="Iniciar sesi&#243;n"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/general_login_register"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:gravity="center"
                android:text="&#191;No tienes cuenta? Reg&#237;strate"
                android:textColor="#777777"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
    </LinearLayout>
    <ImageView
        android:id="@+id/general_login_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/bg_general_button"
        android:contentDescription="Configuracion general"
        android:elevation="6dp"
        android:padding="12dp"
        android:src="@drawable/ic_settings"
        android:tint="@android:color/white" />
</FrameLayout>
