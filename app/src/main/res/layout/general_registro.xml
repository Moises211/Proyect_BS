<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/general_register_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E4E4E4">
    <LinearLayout
        android:id="@+id/general_register_toolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:background="#C51B20">
        <ImageView android:id="@+id/general_register_back" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_arrow_back" android:contentDescription="Volver" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Registro" android:textColor="@android:color/white" android:textSize="22sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alta del Cliente" android:textColor="@android:color/white" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/general_register_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Crea tu cuenta" android:textColor="#252525" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Registro de clientes Good Cuts" android:textColor="#777777" android:textSize="14sp" />
            <LinearLayout android:id="@+id/general_register_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_general_card_light">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <ImageView android:layout_width="40dp" android:layout_height="50dp" android:src="@drawable/ic_general_battery" android:contentDescription="Good Cuts" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Good Cuts" android:textColor="#252525" android:textSize="19sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Acceso para clientes" android:textColor="#287F8D" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                    <include layout="@layout/general_labeled_field" android:id="@+id/register_names" />
                    <include layout="@layout/general_labeled_field" android:id="@+id/register_last_names" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <include layout="@layout/general_labeled_field" android:id="@+id/register_document_type" />
                    <include layout="@layout/general_labeled_field" android:id="@+id/register_document_number" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <include layout="@layout/general_labeled_field" android:id="@+id/register_email" />
                    <include layout="@layout/general_labeled_field" android:id="@+id/register_phone" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <include layout="@layout/general_labeled_field" android:id="@+id/register_birth_date" />
                    <include layout="@layout/general_labeled_field" android:id="@+id/register_service" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/register_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:padding="4dp">
                    <TextView
                        android:id="@+id/general_field_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Contraseña"
                        android:textColor="#263248"
                        android:textSize="16sp" />
                    <EditText
                        android:id="@+id/general_field_input"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_general_field_light"
                        android:inputType="textPassword"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#333333"
                        android:textColorHint="#A4A7B2"
                        android:textSize="16sp" />
                </LinearLayout>
                <TextView android:id="@+id/general_register_submit" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp" android:background="@drawable/bg_general_button" android:gravity="center" android:text="Crear cuenta" android:textColor="@android:color/white" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
