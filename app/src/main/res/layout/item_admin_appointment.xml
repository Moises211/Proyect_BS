<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:layout_margin="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#B5B5B5"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:padding="12dp">
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_module_profile"
            android:padding="10dp"
            android:src="@drawable/ic_badge"
            android:tint="#5B4392" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Corte Clasico Barba"
                android:textColor="#253047"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_person"
                android:drawableTint="#147A3E"
                android:drawablePadding="6dp"
                android:text="Juan Carlos Canales"
                android:textColor="#147A3E"
                android:textSize="15sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_schedule"
                android:drawableTint="#D5A916"
                android:drawablePadding="6dp"
                android:text="3:30 p.m. 17/09/26"
                android:textColor="#D5A916"
                android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="76dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="38dp"
                android:layout_height="44dp"
                android:contentDescription="Cambiar cita"
                android:padding="9dp"
                android:src="@drawable/ic_refresh"
                android:tint="#197A8A" />
            <ImageView
                android:layout_width="38dp"
                android:layout_height="44dp"
                android:contentDescription="Cancelar cita"
                android:padding="9dp"
                android:src="@drawable/ic_close"
                android:tint="#197A8A" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
