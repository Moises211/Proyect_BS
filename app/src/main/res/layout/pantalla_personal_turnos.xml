<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E4E4E4"
    android:fitsSystemWindows="true"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#C51B20"
        android:id="@+id/toolbar_personal_turnos"
        app:navigationIcon="@drawable/ic_menu"
        app:navigationIconTint="@android:color/white"
        app:subtitle="Personal y Turnos"
        app:subtitleTextColor="@android:color/white"
        app:title="Good Cuts Admin"
        app:titleTextColor="@android:color/white" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MODULOS DEL SISTEMA"
                    android:textColor="#242424"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="Selecciona para navegar"
                    android:textColor="#777777"
                    android:textSize="14sp" />
            </LinearLayout>
            <include
                android:id="@+id/card_staff_barbers"
                layout="@layout/item_personal_turnos_module"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="30dp" />
            <include
                android:id="@+id/card_staff_schedule"
                layout="@layout/item_personal_turnos_schedule"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="16dp" />
            <include
                android:id="@+id/card_staff_specialties"
                layout="@layout/item_personal_turnos_specialties"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/admin_bottom_navigation" />
</LinearLayout>
