<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/general_verify_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E4E4E4">
    <LinearLayout android:id="@+id/general_verify_toolbar" android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:background="#C51B20">
        <ImageView android:id="@+id/general_verify_back" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_arrow_back" android:contentDescription="Volver" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Good Cuts" android:textColor="@android:color/white" android:textSize="22sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Código de acceso" android:textColor="@android:color/white" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/general_verify_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingStart="44dp" android:paddingEnd="36dp" android:paddingTop="140dp">
        <ImageView android:layout_width="42dp" android:layout_height="60dp" android:src="@drawable/ic_general_battery" android:contentDescription="Good Cuts" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Verificación" android:textColor="#252525" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Escribe el código enviado a tu correo" android:textColor="#777777" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="28dp" android:orientation="horizontal">
            <EditText android:id="@+id/general_code_one" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:gravity="center" android:background="@drawable/bg_general_code_light" android:inputType="number" android:maxLength="1" android:text="6" android:textColor="#252525" android:textSize="20sp" android:textStyle="bold" />
            <EditText android:id="@+id/general_code_two" android:layout_width="0dp" android:layout_height="54dp" android:layout_marginStart="18dp" android:layout_weight="1" android:gravity="center" android:background="@drawable/bg_general_code_light" android:inputType="number" android:maxLength="1" android:text="9" android:textColor="#252525" android:textSize="20sp" android:textStyle="bold" />
            <EditText android:id="@+id/general_code_three" android:layout_width="0dp" android:layout_height="54dp" android:layout_marginStart="18dp" android:layout_weight="1" android:gravity="center" android:background="@drawable/bg_general_code_light" android:inputType="number" android:maxLength="1" android:textColor="#252525" android:textSize="20sp" android:textStyle="bold" />
            <EditText android:id="@+id/general_code_four" android:layout_width="0dp" android:layout_height="54dp" android:layout_marginStart="18dp" android:layout_weight="1" android:gravity="center" android:background="@drawable/bg_general_code_light" android:inputType="number" android:maxLength="1" android:textColor="#252525" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/general_verify_submit" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="44dp" android:background="@drawable/bg_general_button" android:gravity="center" android:text="Confirmar" android:textColor="@android:color/white" android:textStyle="bold" />
        <TextView android:id="@+id/general_verify_resend" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="50dp" android:gravity="center" android:text="¿No recibiste el código? Reenviar" android:textColor="#287F8D" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
